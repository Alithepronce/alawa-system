# Production Build Output
dist/
release/
*.exe

# Database & Runtime State (Strict Protection: never commit real data, backups, or licenses)
*.db
*.db-wal
*.db-shm
*.db-*
data/*.db*
data/**/*.db*
data/backups/
data/pre_update_backups/
data/.license*
data/server.log
.license*

# Licensing service secrets — never commit or distribute with the desktop app
license-server/license-private.pem
license-server/licenses.db*

# Screenshots in root if temporary
*_view.png
backup_screen_active.png

# Environment & System
.env
.env.local
.DS_Store
Thumbs.db
.vscode/
.idea/
